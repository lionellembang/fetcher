# BINUSMAYA login — used by the Playwright login whenever a session is needed.
BINUS_USERNAME=you@binus.ac.id
BINUS_PASSWORD=PUT_YOUR_PASSWORD_HERE

# Show the browser during login (debugging only).
HEADFUL=false

# Secret path segment for the web UI / API: http://host:PORT/d/<ACCESS_TOKEN>
ACCESS_TOKEN=change-me
PORT=3100

# How often to scan for new recordings, in minutes (default 6h).
SCAN_INTERVAL_MINUTES=360

# Which academic periods to scan, e.g. "2610" or "2610,2520". Empty = the
# currently active period.
PERIODS=

# Download lecture recordings from SharePoint (Playwright signs in to Microsoft
# with the credentials above). false = only track and link them.
DOWNLOAD_RECORDINGS=true
# A single recording download longer than this (minutes) is cancelled.
RECORDING_TIMEOUT_MIN=90

# Where files and state live.
DOWNLOAD_DIR=./downloads
DATA_DIR=./data

# Login resilience: cold-start retries, delay between them, per-attempt timeout.
LOGIN_MAX_ATTEMPTS=3
LOGIN_RETRY_DELAY_SEC=30
LOGIN_ATTEMPT_TIMEOUT_SEC=300

TZ=Asia/Jakarta
