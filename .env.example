# fetcher config: copy to .env (same folder) and fill in. Read by the server,
# the transcriber and scripts/start.sh. Relative paths are from this folder.

# --- BINUSMAYA login: used by Playwright to log in and download recordings ---
BINUS_USERNAME=you@binus.ac.id
BINUS_PASSWORD=PUT_YOUR_PASSWORD_HERE
# Show the browser during login (debugging only).
HEADFUL=false

# --- Web UI + MCP ---
# Secret path segment: the dashboard is <PUBLIC_URL>/d/<ACCESS_TOKEN> and the MCP
# endpoint <PUBLIC_URL>/d/<ACCESS_TOKEN>/mcp. Anyone with it can read your
# transcripts and watch the recordings, so make it long and random:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ACCESS_TOKEN=change-me
# The server only listens locally; the Cloudflare tunnel exposes it.
HOST=127.0.0.1
PORT=3100
# Public base URL, used in the links MCP hands out (no trailing slash).
PUBLIC_URL=https://lectures.example.com
# Name of the Cloudflare tunnel scripts/start.sh runs (empty = no tunnel).
CLOUDFLARE_TUNNEL=fetcher

# --- Scanning + downloads ---
# How often to scan for new recordings while running, in minutes.
SCAN_INTERVAL_MINUTES=360
# Which academic periods to scan, e.g. "2610" or "2610,2520". Empty = the active one.
PERIODS=
DOWNLOAD_RECORDINGS=true
RECORDING_TIMEOUT_MIN=90
DOWNLOAD_DIR=./downloads
DATA_DIR=./data
LOGIN_MAX_ATTEMPTS=3
LOGIN_RETRY_DELAY_SEC=30
LOGIN_ATTEMPT_TIMEOUT_SEC=300

# --- Pipeline ---
# At most this many cut + transcribe jobs at once. 1 = never overlap them
# (use it if WSL runs low on memory).
HEAVY_CONCURRENCY=2
# Audio check: peak below SILENT_DB, or average below SILENT_MEAN_DB, = no audio
# (cut + transcribe skipped). Peak below QUIET_DB or average below QUIET_MEAN_DB
# = quiet (loudness-normalised before Whisper). Normal lectures average ~-25 dB.
SILENT_DB=-60
SILENT_MEAN_DB=-55
QUIET_DB=-20
QUIET_MEAN_DB=-40

# Cut (auto-editor). Changing these re-cuts every recording.
CUT_ENABLED=true
CUT_EDIT=audio:-30dB
CUT_MARGIN=0.3s,0.5s
# Extra auto-editor flags, e.g. "-c:v h264_nvenc" to try the GPU encoder.
CUT_EXTRA_ARGS=
CUT_TIMEOUT_MIN=180

# Transcribe (transcriber/ Whisper server). Changing these re-transcribes.
TRANSCRIBE_ENABLED=true
WHISPER_URL=http://127.0.0.1:8000
WHISPER_MODEL=large-v3
TRANSCRIBE_LANG=id
TRANSCRIBE_GATE_DB=12
# Loudness-normalise audio before Whisper: quiet | always | never
TRANSCRIBE_LOUDNORM=quiet
# Python environment for the transcriber (needs transcriber/requirements.txt).
TRANSCRIBER_VENV=./transcriber/.venv
# Whisper is loaded for a transcription and unloaded (VRAM freed) after this
# many idle seconds; a queue of new lectures loads it once.
WHISPER_KEEP_S=120

# Search index (embeddings, on the CPU in the transcriber). Changing the model re-indexes.
INDEX_ENABLED=true
EMBED_MODEL=intfloat/multilingual-e5-base
CHUNK_WINDOW_SEC=45
CHUNK_OVERLAP_SEC=15
# Match labels (strong / possible / weak): cosine floors, plus z-scores once at
# least SEARCH_MIN_CHUNKS_FOR_Z chunks are indexed. Tune with real questions.
SEARCH_STRONG_COS=0.82
SEARCH_POSSIBLE_COS=0.795
SEARCH_STRONG_Z=3
SEARCH_POSSIBLE_Z=2
SEARCH_MIN_CHUNKS_FOR_Z=200

# --- Two machines: a 24/7 hub + a compute PC (docs/two-server-plan.md) ---
# Where cut + transcribe run: local (this machine, the default) or remote (a
# compute node pulls them from this hub; when it's off they wait as "waiting for PC").
COMPUTE=local
# Shared secret between hub and node (not ACCESS_TOKEN), at least 32 characters:
#   openssl rand -hex 24
NODE_TOKEN=
# Hub: the node API listens only here, for the node on the LAN (not via the tunnel).
# Set NODE_HOST to the Mac's address on the link to the PC to keep it off other networks.
NODE_HOST=0.0.0.0
NODE_PORT=3102
# Hub: a leased job goes back in the queue after this long without a heartbeat.
NODE_LEASE_SEC=600
# Search embeddings (default: WHISPER_URL). On a hub: transcriber/run-embed.sh.
# EMBED_URL=http://127.0.0.1:8000
# EMBED_VENV=./transcriber/.venv-embed   (scripts/macos/run-service embed)
# Node: the hub's node API on the LAN.
# HUB_URL=http://192.168.1.20:3102
# NODE_ID=            (default: the hostname)
# NODE_STAGES=cut,transcribe
# NODE_CACHE_DIR=./data/node-cache
# NODE_CACHE_GB=20
# Which services `scripts/fetcher start all` runs. On the compute PC: "transcriber node".
# FETCHER_SERVICES="transcriber worker web tunnel"

# Tools (defaults: found on PATH)
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# AUTO_EDITOR_BIN=auto-editor

TZ=Asia/Jakarta
